# FILE: .env.example
# DESKRIPSI: Contoh pengaturan. Salin file ini menjadi ".env" lalu isi nilainya.
# Nilai diambil dari Supabase > Project Settings > API (atau tombol "Connect").
# Catatan: di file .env, komentar ditulis dengan tanda pagar (setara "//" di JavaScript).
# Kunci "anon / publishable" memang boleh dipakai di browser. JANGAN PERNAH isi "service_role / secret key" di sini.

# Alamat project Supabase, contoh: https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Kunci publik (anon key yang diawali eyJ... atau publishable key yang diawali sb_publishable_...)
VITE_SUPABASE_ANON_KEY=
